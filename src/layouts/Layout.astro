---
import "../styles/global.css";

import atkinson400 from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2";
import jetbrains700 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2";

import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";

interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width">

		<link rel="icon" href="/favicon.png">

		<meta name="generator" content={Astro.generator}>
		<title>{title}</title>

		<link
			rel="preload"
			href={atkinson400}
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<link
			rel="preload"
			href={jetbrains700}
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>

	<body>
		<div class="flex flex-col w-full md:mx-auto md:max-w-[1000px] font-sans px-6 py-5 lg:my-10 lg:px-20 bg-panel border border-border relative min-h-screen">
			<Navbar />

			<div class="my-10 w-full md:my-20 flex-1">
				<slot />
			</div>

			<Footer />
		</div>
	</body>
</html>
