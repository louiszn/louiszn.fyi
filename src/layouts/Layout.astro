---
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";

import atkinson400 from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2";
import jetbrains700 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2";

import Footer from "#/components/Footer.astro";
import Sidebar from "#/components/sidebar/Sidebar.astro";

interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark" transition:animate="none">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width">

		<link rel="icon" href="/favicon.png">

		<meta name="generator" content={Astro.generator}>
		<title>{title}</title>

		<link
			rel="preload"
			href={atkinson400}
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<link
			rel="preload"
			href={jetbrains700}
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<ClientRouter />
	</head>

	<body>
		<div
			class="
				flex flex-col xl:flex-row
				w-full md:mx-auto md:max-w-[1400px]
				xl:lg:my-10
				bg-panel
				xl:border-2 border-dashed border-border
				min-h-screen
				xl:rounded-xl
			"
		>
			<Sidebar />

			<div class="flex flex-col w-full min-h-screen relative">
				<div class="flex-1 px-5 mt-15 md:mx-15">
					<slot />
				</div>

				<Footer />
			</div>
		</div>
	</body>
</html>
