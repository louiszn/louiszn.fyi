---
import Layout from "./Layout.astro";

interface Props {
	frontmatter: {
		title: string;
	};
}

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
	<article
		class="
			w-full max-w-screen!
			prose-sm md:prose lg:prose-lg dark:prose-invert
			text-justify
			hyphens-auto
			prose-h1:font-mono
			prose-h2:font-mono
			prose-h3:font-mono
			prose-h4:font-mono
			prose-h5:font-mono
			prose-ul:list-disc prose-ul:pl-6
			prose-blockquote:border-l-4
		"
	>
		<slot />
	</article>
</Layout>
