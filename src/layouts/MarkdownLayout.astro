---
import type { MarkdownLayoutProps } from "astro";
import Layout from "./Layout.astro";

type Props = MarkdownLayoutProps<{
	title: string;
}>;

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
	<article
		class="w-full prose-sm md:prose lg:prose-lg dark:prose-invert max-w-screen! prose-h1:text-center prose-ul:list-disc prose-ul:pl-6 text-justify prose-blockquote:border-l-4"
	>
		<slot />
	</article>
</Layout>
