---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import { estimateReadTime, formatPublishDate } from "../../utils/post.ts";

const posts = await getCollection("posts");

posts.sort(
	(a, b) => (
		b.data.publishDate.valueOf() -
		a.data.publishDate.valueOf()
	)
);
---

<Layout title="Louiszn - Posts">
	<div class="flex flex-col gap-5">
		{posts.map((post) =>
			<a href={`/posts/${post.id}`} class="flex items-center justify-between border border-border border-dashed px-6 py-4">
				<div class="flex flex-col">
					<span class="text-2xl font-mono">{post.data.title}</span>
					<span>{post.data.description}</span>
				</div>

				<div class="flex flex-col text-end">
					<span>{estimateReadTime(post.body)} min read</span>
					<span>{formatPublishDate(post.data.publishDate)}</span>
				</div>
			</a>
		)}
	</div>
</Layout>
