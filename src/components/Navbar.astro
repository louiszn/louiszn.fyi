---
import { cn } from "../utils/tailwind.ts";

const PAGES = [
	{
		label: "Home",
		href: "/",
	},
	{
		label: "About",
		href: "/about",
	},
	{
		label: "Posts",
		href: "/posts",
	},
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<nav
	class="
		flex
		justify-center
		lg:absolute lg:left-[-1px] lg:top-[-21px]
		lg:bg-panel
		lg:border-x lg:border-t lg:border-border
	"
>
	<div class="flex font-mono text-base md:text-lg">
		{PAGES.map((page) => (
			<a
				href={page.href}
				class={cn(
					"px-3 py-1 md:px-5 md:py-2",
					isActive(page.href) ? "text-black bg-accent" : "text-muted hover:text-fg",
				)}
			>
				{page.label}
			</a>
		))}
	</div>
</nav>
