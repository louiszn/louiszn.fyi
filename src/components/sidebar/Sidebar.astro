---
import SidebarContent from "./SidebarContent.astro";
---

<div class="hidden xl:block xl:rounded-l-xl xl:w-[250px] min-h-screen bg-sidebar">
	<SidebarContent groupName="sidebar-group-desktop" />
</div>

<details id="sidebar" class="xl:hidden">
	<summary class="
			flex fixed
			items-center justify-center
			z-99
			cursor-pointer
			bg-sidebar
			w-10 h-10
			left-1 top-1
			border-2 border-border
		"
	>
		X
	</summary>

	<div class="fixed inset-y-0 left-0 z-98 w-full md:w-[350px] overflow-y-auto pt-7 bg-sidebar">
		<SidebarContent groupName="sidebar-group-mobile" />
	</div>
</details>

<style>
	#sidebar[open] summary {
		border: none;
	}
</style>

<script>
	const VISITED_KEY = "visited";

	async function getVisitCount(method: "GET" | "POST"): Promise<number | undefined> {
		const response = await fetch("/api/visit", { method });

		if (!response.ok) {
			return undefined;
		}

		const data = await response.json();
		return data.count;
	}

	async function updateVisitorCount() {
		const today = new Date().toISOString().slice(0, 10);
		const lastVisit = localStorage.getItem(VISITED_KEY);

		const counters = document.querySelectorAll("#visitor-count");

		if (counters.length === 0) {
			return;
		}

		let count: number | undefined;

		if (lastVisit !== today) {
			count = await getVisitCount("POST");

			if (count !== undefined) {
				localStorage.setItem(VISITED_KEY, today);
			}
		}

		if (count === undefined) {
			count = await getVisitCount("GET");
		}

		if (count === undefined) {
			return;
		}

		counters.forEach((counter) => {
			const digits = String(count).split("").map((digit) => {
				const img = document.createElement("img");
				img.src = `/assets/counter/${digit}.gif`;
				img.alt = digit;
				img.className = "w-[30px] md:w-[35px]";
				return img;
			});

			counter.replaceChildren(...digits);
			counter.setAttribute("title", `You are the ${ordinal(count)} visitor`);
		});
	}

	function ordinal(n: number): string {
		const mod100 = n % 100;
		if (mod100 >= 11 && mod100 <= 13) return `${n}th`;

		switch (n % 10) {
			case 1: return `${n}st`;
			case 2: return `${n}nd`;
			case 3: return `${n}rd`;
			default: return `${n}th`;
		}
	}

	updateVisitorCount();
	document.addEventListener("astro:page-load", updateVisitorCount);
</script>
