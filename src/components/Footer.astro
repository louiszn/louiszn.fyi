---
import internet from "#/assets/88x31/internetprivacy.gif";
import noai from "#/assets/88x31/noai.avif";
import voidlinux from "#/assets/88x31/void.gif";

import WebButton, { type Props as WebButtonProps } from "./WebButton.astro";
import Link from "./Link.astro";

const hash = import.meta.env.PUBLIC_DEPLOYMENT_HASH?.slice(0, 4) ?? "0000";

const FAVORITE_BUTTONS: WebButtonProps[] = [
	{
		src: voidlinux,
		href: "https://voidlinux.org",
		title: "Void Linux",
	},
	{
		src: internet,
		href: "/privacy",
		title: "Internet privacy!",
	},
	{
		src: noai,
		title: "No AI!!!",
	},
];

const FRIEND_BUTTONS: WebButtonProps[] = [
	{
		src: "/assets/88x31/me.png",
		href: "/88x31",
		title: "Meowwww",
	},
	{
		src: "https://calev.pages.dev/88x31.jpg",
		href: "https://calev.pages.dev/",
		title: "Pumkin pie",
	},
];

const LINKS = [
	{
		label: "Licenses",
		href: "/licenses",
	},
	{
		label: "Source code",
		href: "https://codeberg.org/louiszn/louiszn.fyi"
	},
	{
		label: `Build #${hash}`,
		href: `https://codeberg.org/louiszn/louiszn.fyi/commit/${hash}`,
	}
];
---

<footer class="flex flex-col items-center gap-1 px-6 py-6 text-sm md:text-base">
	<div>© 2026 Louiszn</div>

	<div class="flex flex-wrap justify-center gap-3">
		{LINKS.map((link) =>
			<Link href={link.href}>{link.label}</Link>
		)}
	</div>
</footer>

