---
import internet from "../assets/88x31/internetprivacy.gif";
import noai from "../assets/88x31/noai.avif";
import voidlinux from "../assets/88x31/void.gif";

import WebButton, { type Props as WebButtonProps } from "./WebButton.astro";

const hash = import.meta.env.PUBLIC_DEPLOYMENT_HASH?.slice(0, 7) ?? "0000000";

const FAVORITE_BUTTONS: WebButtonProps[] = [
	{
		src: voidlinux,
		href: "https://voidlinux.org",
		title: "Void Linux",
	},
	{
		src: internet,
		title: "Internet privacy!",
	},
	{
		src: noai,
		title: "No AI!!!",
	},
];

const FRIEND_BUTTONS: WebButtonProps[] = [
	{
		src: "/assets/88x31/me.png",
		href: "/88x31",
		title: "Meowwww",
	},
	{
		src: "https://calev.pages.dev/88x31.jpg",
		href: "https://calev.pages.dev/",
		title: "Pumkin pie",
	},
];
---

<footer
	class="flex flex-col items-center justify-center px-6 py-4 gap-5 text-sm md:text-lg"
>
	<div class="flex flex-col items-center gap-2 text-center">
		<div>Build with ❤️ by Louiszn</div>

		<div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
			<span>© 2026 Louiszn</span>

			<a
				href="https://codeberg.org/louiszn/louiszn.fyi"
				class="underline underline-offset-2"
				target="_blank"
				rel="noopener noreferrer"
			>
				Source code
			</a>

			<a
				href={`https://codeberg.org/louiszn/louiszn.fyi/commit/${hash}`}
				class="font-mono underline underline-offset-2"
				target="_blank"
				rel="noopener noreferrer"
			>
				#{hash}
			</a>
		</div>
	</div>

	<div class="flex flex-col gap-1">
		<div class="flex flex-wrap gap-1 justify-center">
			{FAVORITE_BUTTONS.map((item) => (<WebButton {...item} />))}
		</div>

		<div class="flex flex-wrap gap-1 justify-center">
			{FRIEND_BUTTONS.map((item) => (<WebButton {...item} />))}
		</div>
	</div>

	<div id="visitor-count" class="flex"></div>
</footer>

<script>
	const VISITED_KEY = "visited";

	const today = new Date().toISOString().slice(0, 10);
	const lastVisit = localStorage.getItem(VISITED_KEY);

	let count;

	if (lastVisit !== today) {
		const response = await fetch("/api/visit", {
			method: "POST",
		});

		if (response.ok) {
			const data = await response.json();

			count = data.count;
			localStorage.setItem(VISITED_KEY, today);
		}
	}

	if (!count) {
		const response = await fetch("/api/visit", {
			method: "GET",
		});

		if (response.ok) {
			const data = await response.json();
			count = data.count;
		}
	}

	const counter = document.querySelector("#visitor-count");

	if (counter) {
		const digits = String(count).split("").map((digit) => {
			const img = document.createElement("img");

			img.src = `/assets/counter/${digit}.gif`;
			img.alt = digit;
			img.className = "w-[40px] md:w-[55px]";

			return img;
		});

		counter.replaceChildren(...digits);
		counter.setAttribute("title", `You are the ${ordinal(count)} visitor`);
	}

	function ordinal(n: number): string {
		const mod100 = n % 100;

		if (mod100 >= 11 && mod100 <= 13) return `${n}th`;

		switch (n % 10) {
			case 1:
				return `${n}st`;
			case 2:
				return `${n}nd`;
			case 3:
				return `${n}rd`;
			default:
				return `${n}th`;
		}
	}
</script>
